{
  "mcpServers": {
    "rustmistmcp": {
      "command": "/usr/local/bin/rustmistmcp",
      "args": [
        "--transport", "stdio",
        "--device-mapping", "/etc/rustmistmcp/mist.json",
        "--state-file", "/var/lib/rustmistmcp/changeset-state.json"
      ]
    },
    "rustmistmcp-oci": {
      "command": "docker",
      "args": [
        "run", "--rm", "-i",
        "--user", "65532:65532",
        "-v", "/absolute/path/to/mist.json:/etc/rustmistmcp/mist.json:ro",
        "-v", "/absolute/path/to/mist-api-token:/etc/rustmistmcp/mist-api-token:ro",
        "-v", "/absolute/path/to/state-dir:/var/lib/rustmistmcp",
        "ghcr.io/mechubsec/rustmistmcp:0.4.0",
        "--transport", "stdio",
        "--state-file", "/var/lib/rustmistmcp/changeset-state.json"
      ]
    }
  }
}
